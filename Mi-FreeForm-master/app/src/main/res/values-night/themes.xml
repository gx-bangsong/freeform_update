<resources>
    <style name="Theme.FreeForm" parent="Theme.Material3.DayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">?colorPrimary</item>
        <item name="colorSecondary">?colorPrimary</item>
        <item name="colorSecondaryVariant">?colorSecondary</item>
        <item name="colorOnSecondary">?colorOnPrimary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorOnSurface">@color/color_text</item>
        <item name="colorOnBackground">@color/color_text</item>
        <item name="colorSurfaceVariant">@color/color_surface</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:windowBackground">@color/color_surface</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FreeForm.Dialog</item>
        <!--背景颜色-->
        <item name="colorSurface">@color/color_surface</item>
        <item name="android:colorBackground">?colorSurface</item>

        <!--保证状态栏颜色-->
        <item name="colorPrimaryDark">?colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/color_surface</item>
        <item name="android:navigationBarColor">@color/color_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.FreeForm.ActionBarTheme" parent="Widget.Material3.ActionBar.Solid">
        <item name="colorPrimary">@color/color_surface</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.FreeForm.FloatingViewTheme" parent="Theme.Material3.DayNight">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="colorPrimaryDark">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ThemeOverlay.FreeForm.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/color_surface</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>
</resources>